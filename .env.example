# Database (Supabase pooler). For local development put a local DATABASE_URL in
# .env.local: it overrides this file for both Next.js and Prisma.
DATABASE_URL=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Canonical public URL used for SEO (sitemap, canonical links, share images).
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXTAUTH_URL=http://localhost:3000
AUTH_SECRET=

# Auth providers (optional)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Resend: magic-link sign-in and all outgoing email (newsletter, reminders)
AUTH_RESEND_KEY=
AUTH_EMAIL_FROM=

# Stripe (test mode first)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_COMMUNITY=
STRIPE_PRICE_ID_COMMUNITY_ANNUAL=
STRIPE_PRICE_ID_COMMUNITY_FOUNDING=
STRIPE_PRICE_ID_PROFESSIONAL=
STRIPE_PRICE_ID_PROFESSIONAL_ANNUAL=
STRIPE_PRICE_ID_PROFESSIONAL_FOUNDING=
STRIPE_PRICE_ID_BUSINESS=
STRIPE_PRICE_ID_BUSINESS_ANNUAL=
STRIPE_PRICE_ID_COMMUNITY_FOUNDING_ANNUAL=
STRIPE_PRICE_ID_PROFESSIONAL_FOUNDING_ANNUAL=
# Premium Business, yearly and sold online
STRIPE_PRICE_ID_PREMIUM=
STRIPE_PRICE_ID_PREMIUM_FOUNDING=
# Legacy prices: existing subscribers still resolve to a plan
STRIPE_PRICE_ID_MEMBER=
STRIPE_PRICE_ID_BUSINESS_STANDARD=
STRIPE_PRICE_ID_BUSINESS_LUXURY=

# AI (Vercel AI Gateway). Without a key, agents fall back to templates.
AI_GATEWAY_API_KEY=
TRICHO_AI_MODEL=
TRICHO_AGENT_MODEL=

# Vercel Cron authorisation for /api/cron/*
CRON_SECRET=

# Local only — never enable in production
DEV_MEMBERSHIP_UNLOCK=true

# Stripe publishable key, so the partner card form sits inside the onboarding page.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
