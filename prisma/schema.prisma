generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  individual
  trichologist
  business
  admin
}

enum Profession {
  cosmetic
  clinical
  medical
  brand
}

enum ListingStatus {
  pending
  listed
  rejected
  draft
  invited
}

enum ListingKind {
  listed
  member
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          UserRole  @default(individual)
  accounts      Account[]
  sessions      Session[]

  stripeCustomerId       String?   @unique
  stripeSubscriptionId   String?   @unique
  stripePriceId          String?
  stripeCurrentPeriodEnd DateTime?

  profile   TrichologistProfile?
  posts     CommunityPost[]
  comments  Comment[]
  reactions Reaction[]
  listings  DirectoryListing[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TrichologistProfile {
  id             String      @id @default(cuid())
  userId         String      @unique
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio            String?
  specialization String?
  location       String?
  website        String?
  phone          String?
  profession     Profession?
  listingStatus  ListingStatus @default(draft)
  isVerified     Boolean     @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DirectoryListing {
  id             String        @id @default(cuid())
  name           String
  email          String
  profession     Profession
  city           String
  specialization String?
  bio            String?       @db.Text
  website        String?
  phone          String?
  status         ListingStatus @default(pending)
  kind           ListingKind   @default(listed)
  userId         String?
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  reviewedAt     DateTime?
  reviewNote     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([email])
}

model CommunityPost {
  id        String     @id @default(cuid())
  title     String?
  content   String     @db.Text
  category  String
  space     String     @default("everyone")
  pinned    Boolean    @default(false)
  authorId  String
  author    User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments  Comment[]
  reactions Reaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([space, createdAt])
}

model Comment {
  id       String        @id @default(cuid())
  content  String        @db.Text
  postId   String
  post     CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId String
  author   User          @relation(fields: [authorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId])
}

model Reaction {
  id     String        @id @default(cuid())
  type   String        @default("useful")
  postId String
  post   CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId String
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([postId])
}

model EducationPiece {
  id        String   @id @default(cuid())
  title     String
  summary   String
  body      String   @db.Text
  audience  String
  kind      String
  published Boolean  @default(true)
  sortOrder Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([audience, sortOrder])
}

model ExchangeItem {
  id          String  @id @default(cuid())
  title       String
  description String  @db.Text
  link        String?
  type        String
  businessId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}
